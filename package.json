{
  "name": "portifact-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts",
      "spikes/*",
      "e2e"
    ],
    "catalog": {
      "@stryker-mutator/core": "^10.1.1",
      "@stryker-mutator/vitest-runner": "^10.1.1",
      "@testing-library/react": "^16.0.0",
      "@types/node": "^26.0.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@vitest/coverage-istanbul": "^5.1.0",
      "axe-core": "^4.10.0",
      "happy-dom": "^21.0.4",
      "lucide-react": "^1.69.0",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "typescript": "^7.0.0",
      "vitest": "^5.1.0"
    }
  },
  "scripts": {
    "check": "biome check . && tsc -p tsconfig.json && bun scripts/check-skills.ts && bun scripts/check-design-system.ts && bun scripts/third-party-notices.ts --check && turbo run typecheck",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:mutation": "turbo run test:mutation --concurrency=1",
    "build:cli": "bun scripts/build-cli.ts",
    "notices": "bun scripts/third-party-notices.ts",
    "spike:review-cookies": "bun run --cwd spikes/review-cookies spike",
    "spike:regions": "bun run --cwd spikes/regions test",
    "spike:artifact-analytics": "bun run --cwd spikes/artifact-analytics test",
    "test:e2e": "turbo run build --filter=@portifact/web --filter=@portifact/bridge --filter=@portifact/render && bun run --cwd e2e e2e",
    "landing:shots": "turbo run build --filter=@portifact/web --filter=@portifact/bridge --filter=@portifact/render && bun run --cwd e2e shots",
    "test:load": "turbo run build --filter=@portifact/web --filter=@portifact/bridge --filter=@portifact/render && node scripts/load-test.ts",
    "dev": "turbo run dev",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@semantic-release/exec": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@types/bun": "^1.0.0",
    "@types/node": "catalog:",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.0",
    "turbo": "^2.0.0",
    "typescript": "catalog:"
  }
}
