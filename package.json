{
  "name": "portifact-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts",
      "spikes/*"
    ],
    "catalog": {
      "@testing-library/react": "^16.0.0",
      "@types/node": "^26.0.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@vitest/coverage-istanbul": "^4.1.0",
      "axe-core": "^4.10.0",
      "happy-dom": "^21.0.4",
      "lucide-react": "^1.0.0",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "typescript": "^7.0.0",
      "vitest": "^4.1.0"
    }
  },
  "scripts": {
    "check": "biome check . && tsc -p tsconfig.json && bun scripts/check-skills.ts && bun scripts/check-design-system.ts && turbo run typecheck",
    "format": "biome check --write .",
    "test": "turbo run test",
    "build:cli": "bun scripts/build-cli.ts",
    "spike:review-cookies": "bun run --cwd spikes/review-cookies spike",
    "dev": "turbo run dev",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@semantic-release/exec": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@types/bun": "^1.0.0",
    "@types/node": "catalog:",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "semantic-release": "^25.0.0",
    "turbo": "^2.0.0",
    "typescript": "catalog:"
  }
}
