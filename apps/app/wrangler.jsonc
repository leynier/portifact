{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "portifact-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // global_fetch_strictly_public keeps Client ID Metadata Document fetches off private and
  // internal addresses (docs/decisions/0001-oauth-server.md).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // The Worker routes by host: the site on the apex and www, identity and OAuth on app.
  "routes": [
    { "pattern": "portifact.com", "custom_domain": true },
    { "pattern": "www.portifact.com", "custom_domain": true },
    { "pattern": "app.portifact.com", "custom_domain": true }
  ],
  // Static assets are built by apps/web: the landing and the auth pages. Every request except
  // the hashed bundles reaches the Worker first, so it can decide by host what to serve.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Non-secret configuration. Secrets (BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET,
  // GITHUB_CLIENT_SECRET, TURNSTILE_SECRET_KEY, UNSUBSCRIBE_SECRET, WEBHOOK_KEY) are set with
  // `wrangler secret put`; see
  // docs/releasing.md. TURNSTILE_SITE_KEY is the public site key of the `portifact-app`
  // Turnstile widget; without it or its secret, new accounts are refused (fail closed).
  "vars": {
    "APP_ORIGIN": "https://app.portifact.com",
    "GOOGLE_CLIENT_ID": "929390487848-4aapfnvndu3g70ihbg8k0g4ad0fa86pv.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Ov23liDZT9UwEKl6rZoY",
    "CONTENT_DOMAIN": "portifact.dev",
    "R2_ACCOUNT_ID": "6df65be91ad130fd6aa8cb64ac017f22",
    "R2_BUCKET": "portifact-artifacts",
    // The EU region's bucket, signed against the EU endpoint with the secrets
    // R2_ACCESS_KEY_ID_EU and R2_SECRET_ACCESS_KEY_EU (a token limited to that bucket).
    "R2_BUCKET_EU": "portifact-artifacts-eu",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF462kw4p7tuP3gM"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portifact-control",
      "database_id": "6cf93803-aa3c-4859-9f58-e36e2fd784e3",
      "migrations_dir": "../../packages/db/migrations"
    },
    // The access log (plan section 14: a D1 database of its own). The app only reads it, for the owner.
    // The maintainer creates it once and puts its ID here (docs/releasing.md).
    {
      "binding": "ACCESS_DB",
      "database_name": "portifact-access",
      "database_id": "b5285aa9-aa8d-4c2c-9828-22e31c1aec9e",
      "migrations_dir": "../../packages/db/access-migrations"
    },
    // The EU region's databases (decision 0005; docs/releasing.md, "EU region"), both in the EU
    // jurisdiction. An EU workspace's data lives only there.
    {
      "binding": "DB_EU",
      "database_name": "portifact-control-eu",
      "database_id": "fb06a466-a5c3-4fda-a1dc-af6a4e12c9a4",
      "migrations_dir": "../../packages/db/migrations"
    },
    {
      "binding": "ACCESS_DB_EU",
      "database_name": "portifact-access-eu",
      "database_id": "5a29e108-935d-4e21-9429-a6bcde78659b",
      "migrations_dir": "../../packages/db/access-migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "portifact-artifacts" },
    { "binding": "ARTIFACTS_EU", "bucket_name": "portifact-artifacts-eu", "jurisdiction": "eu" }
  ],
  // Cloudflare Email Service, onboarded for portifact.com. Sends sign-in codes.
  "send_email": [{ "name": "EMAIL" }],
  // Portifact's own log lines (`logEvent`) are kept. Cloudflare's invocation logs are off: they
  // record each request's URL, which for an EU workspace holds file paths and search text, and
  // Workers Logs states no storage location (decision 0005, "What leaves the EU").
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": false }
  }
}
