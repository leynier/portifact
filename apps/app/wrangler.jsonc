{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "portifact-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "portifact.com", "custom_domain": true },
    { "pattern": "www.portifact.com", "custom_domain": true }
  ],
  // The landing is built by apps/web. Requests matching run_worker_first reach the Worker
  // before static assets; everything else is served from the assets when it exists.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/install", "/install.ps1"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
