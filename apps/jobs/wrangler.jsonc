{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "portifact-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // `global_fetch_strictly_public`: webhook deliveries (decision 0009) reach every host exactly as
  // an outside client would, never another zone's origin or a Worker of this account directly.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // No routes: this Worker only runs on its schedule and its queue. Maintenance every 15 minutes;
  // the outbox relay every minute, so webhook deliveries go within minutes (decision 0009).
  "triggers": { "crons": ["*/15 * * * *", "* * * * *"] },
  // Both queues must exist before the first deploy that binds them (docs/releasing.md):
  // `wrangler queues create portifact-jobs` and `wrangler queues create portifact-email-events`.
  // The schedule relays outbox rows to `portifact-jobs` and the consumer runs them; Cloudflare
  // Email Service publishes bounces and complaints to `portifact-email-events` through an event
  // subscription the maintainer creates in the dashboard.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "portifact-jobs" }],
    "consumers": [
      {
        "queue": "portifact-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10
      },
      {
        "queue": "portifact-email-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portifact-control",
      "database_id": "6cf93803-aa3c-4859-9f58-e36e2fd784e3",
      "migrations_dir": "../../packages/db/migrations"
    },
    // The access log (plan section 14: a D1 database of its own). The jobs Worker prunes it and erases purged artifacts and deleted accounts.
    // The maintainer creates it once and puts its ID here (docs/releasing.md).
    {
      "binding": "ACCESS_DB",
      "database_name": "portifact-access",
      "database_id": "b5285aa9-aa8d-4c2c-9828-22e31c1aec9e",
      "migrations_dir": "../../packages/db/access-migrations"
    },
    // The EU region's databases (decision 0005; docs/releasing.md, "EU region"), both in the EU
    // jurisdiction. Every scan and job of an EU owner runs on them.
    {
      "binding": "DB_EU",
      "database_name": "portifact-control-eu",
      "database_id": "fb06a466-a5c3-4fda-a1dc-af6a4e12c9a4",
      "migrations_dir": "../../packages/db/migrations"
    },
    {
      "binding": "ACCESS_DB_EU",
      "database_name": "portifact-access-eu",
      "database_id": "5a29e108-935d-4e21-9429-a6bcde78659b",
      "migrations_dir": "../../packages/db/access-migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "portifact-artifacts" },
    { "binding": "ARTIFACTS_EU", "bucket_name": "portifact-artifacts-eu", "jurisdiction": "eu" }
  ],
  // Expiry notices to owners (docs/operations.md), sent from noreply@portifact.com like the
  // sign-in codes of portifact-app, with links to the artifacts and the dashboard.
  "send_email": [{ "name": "EMAIL" }, { "name": "BUDGET_EMAIL" }],
  "vars": {
    "APP_ORIGIN": "https://app.portifact.com",
    "CONTENT_DOMAIN": "portifact.dev",
    // Budget alerts (docs/operations.md): hello@ forwards to the operator through Email Routing.
    "BUDGET_ALERT_TO": "hello@portifact.com",
    "BUDGET_ALERT_FROM": "noreply@portifact.com"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
