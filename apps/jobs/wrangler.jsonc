{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "portifact-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // No routes: this Worker only runs on its schedule and its queue.
  "triggers": { "crons": ["*/15 * * * *"] },
  // The queue must exist before the first deploy: `wrangler queues create portifact-jobs`
  // (docs/releasing.md). The schedule relays outbox rows to it and the consumer runs them.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "portifact-jobs" }],
    "consumers": [
      { "queue": "portifact-jobs", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 10 }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portifact-control",
      "database_id": "6cf93803-aa3c-4859-9f58-e36e2fd784e3",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "portifact-artifacts" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
