{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "portifact-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // No routes: this Worker only runs on its schedule.
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portifact-control",
      "database_id": "6cf93803-aa3c-4859-9f58-e36e2fd784e3",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "portifact-artifacts" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
