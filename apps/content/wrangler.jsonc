{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "portifact-content",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Every artifact origin: <id>.portifact.dev. Needs a proxied wildcard DNS record.
  "routes": [{ "pattern": "*.portifact.dev/*", "zone_name": "portifact.dev" }],
  // Secret, set with `wrangler secret put`: READ_SESSION_SECRET signs read session cookies
  // (docs/releasing.md). Without it protected artifacts answer 503 and public ones still work.
  "vars": {
    "CONTENT_DOMAIN": "portifact.dev",
    "APP_ORIGIN": "https://app.portifact.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portifact-control",
      "database_id": "6cf93803-aa3c-4859-9f58-e36e2fd784e3",
      "migrations_dir": "../../packages/db/migrations"
    },
    // The access log (plan section 14: a D1 database of its own). Delivery only adds openings.
    // The maintainer creates it once and puts its ID here (docs/releasing.md).
    {
      "binding": "ACCESS_DB",
      "database_name": "portifact-access",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../../packages/db/access-migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "portifact-artifacts" }],
  // Per-visitor counters that apply only while budget protection tightens traffic (src/budget.ts,
  // docs/operations.md): public traffic from the third protection step, protected traffic from
  // the fourth. One SQLite-backed Durable Object per visitor IP and kind of traffic; the limits
  // are PROTECTION_TRAFFIC_LIMITS in packages/domain. Workers Rate Limiting was replaced because
  // its counts are approximate and it did not enforce in production.
  "durable_objects": {
    "bindings": [{ "name": "TRAFFIC_LIMITER", "class_name": "TrafficLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrafficLimiter"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
