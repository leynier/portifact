{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "portifact-content",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Every artifact origin: <id>.portifact.dev. Needs a proxied wildcard DNS record.
  "routes": [{ "pattern": "*.portifact.dev/*", "zone_name": "portifact.dev" }],
  // Secret, set with `wrangler secret put`: READ_SESSION_SECRET signs read session cookies
  // (docs/releasing.md). Without it protected artifacts answer 503 and public ones still work.
  "vars": {
    "CONTENT_DOMAIN": "portifact.dev",
    "APP_ORIGIN": "https://app.portifact.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portifact-control",
      "database_id": "6cf93803-aa3c-4859-9f58-e36e2fd784e3",
      "migrations_dir": "../../packages/db/migrations"
    },
    // The access log (plan section 14: a D1 database of its own). Delivery only adds openings.
    // The maintainer creates it once and puts its ID here (docs/releasing.md).
    {
      "binding": "ACCESS_DB",
      "database_name": "portifact-access",
      "database_id": "b5285aa9-aa8d-4c2c-9828-22e31c1aec9e",
      "migrations_dir": "../../packages/db/access-migrations"
    },
    // The EU region's databases (decision 0005; docs/releasing.md, "EU region"), both in the EU
    // jurisdiction. Delivery reads an EU workspace's artifacts from them.
    {
      "binding": "DB_EU",
      "database_name": "portifact-control-eu",
      "database_id": "fb06a466-a5c3-4fda-a1dc-af6a4e12c9a4",
      "migrations_dir": "../../packages/db/migrations"
    },
    {
      "binding": "ACCESS_DB_EU",
      "database_name": "portifact-access-eu",
      "database_id": "5a29e108-935d-4e21-9429-a6bcde78659b",
      "migrations_dir": "../../packages/db/access-migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "portifact-artifacts" },
    { "binding": "ARTIFACTS_EU", "bucket_name": "portifact-artifacts-eu", "jurisdiction": "eu" }
  ],
  // Per-visitor counters that apply only while budget protection tightens traffic (src/budget.ts,
  // docs/operations.md): public traffic from the third protection step, protected traffic from
  // the fourth. One SQLite-backed Durable Object per visitor IP and kind of traffic; the limits
  // are PROTECTION_TRAFFIC_LIMITS in packages/domain. Workers Rate Limiting was replaced because
  // its counts are approximate and it did not enforce in production.
  // ARTIFACT_DOCUMENTS: the documents objects of artifact data (decision 0026), exported by
  // `portifact-data`, which deploys first. The page's data routes reach them only while
  // ARTIFACT_DATA_ENABLED is "true", which no deployed configuration sets.
  "durable_objects": {
    "bindings": [
      { "name": "TRAFFIC_LIMITER", "class_name": "TrafficLimiter" },
      {
        "name": "ARTIFACT_DOCUMENTS",
        "class_name": "ArtifactDocuments",
        "script_name": "portifact-data"
      }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrafficLimiter"] }],
  // Portifact's own log lines (`logEvent`) are kept. Cloudflare's invocation logs are off: they
  // record each request's URL, which for an EU workspace holds file paths and search text, and
  // Workers Logs states no storage location (decision 0005, "What leaves the EU").
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": false }
  }
}
