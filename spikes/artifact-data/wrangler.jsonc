{
  // Test-only configuration of the spike's data Worker (decision 0026): it exports the one
  // Durable Object class and nothing else. Never deployed.
  "name": "portifact-data-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ARTIFACT_DATA", "class_name": "ArtifactData" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArtifactData"] }]
}
