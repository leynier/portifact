{
  // Test-only configuration of the spike's data Worker (decision 0026). Never deployed.
  "name": "portifact-data-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "DOCUMENTS", "class_name": "ArtifactDocuments" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArtifactDocuments"] }]
}
